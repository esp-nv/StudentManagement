@model StudentManagement.ViewModels.CourseOfferingViewModel

@{
    ViewData["Title"] = "Edit Course Offering";
}

<h1>Edit Course Offering</h1>

<form asp-action="Edit" method="post">

    <div asp-validation-summary="ModelOnly"
         class="text-danger">
    </div>

    <div class="mb-3">
        <label asp-for="CourseId" class="form-label">
            Course *
        </label>

        <select asp-for="CourseId"
                class="form-select">
            <option value="">-- Select Course --</option>

            @foreach (var course in Model.Courses)
            {
                <option value="@course.Id">
                    @course.Code - @course.Name
                </option>
            }
        </select>

        <span asp-validation-for="CourseId"
              class="text-danger">
        </span>
    </div>

    <div class="mb-3">
        <label asp-for="StartDate" class="form-label">
            Start date *
        </label>

        <input asp-for="StartDate"
               type="date"
               class="form-control" />

        <span asp-validation-for="StartDate"
              class="text-danger">
        </span>
    </div>

    <div class="mb-3">
        <label asp-for="EndDate" class="form-label">
            End date *
        </label>

        <input asp-for="EndDate"
               type="date"
               class="form-control" />

        <span asp-validation-for="EndDate"
              class="text-danger">
        </span>
    </div>

    <div class="mb-3">
        <label asp-for="EnrollmentStartDate" class="form-label">
            Enrollment start date *
        </label>

        <input asp-for="EnrollmentStartDate"
               type="date"
               class="form-control" />

        <span asp-validation-for="EnrollmentStartDate"
              class="text-danger">
        </span>
    </div>

    <div class="mb-3">
        <label asp-for="EnrollmentEndDate" class="form-label">
            Enrollment end date *
        </label>

        <input asp-for="EnrollmentEndDate"
               type="date"
               class="form-control" />

        <span asp-validation-for="EnrollmentEndDate"
              class="text-danger">
        </span>
    </div>

    <div class="mb-3">
        <label asp-for="Capacity" class="form-label">
            Capacity *
        </label>

        <input asp-for="Capacity"
               type="number"
               min="1"
               class="form-control" />

        <span asp-validation-for="Capacity"
              class="text-danger">
        </span>
    </div>

    <button type="submit"
            class="btn btn-primary">
        Save
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
