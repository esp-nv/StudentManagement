@{
}
@model StudentManagement.Models.Student
@using StudentManagement.Common.Constants


<h1>Edit Student</h1>

<form asp-action="Edit" method="post">

    <input type="hidden" asp-for="Id" />

    <input type="hidden"
           id="dateOfBirthConfirmed"
           name="dateOfBirthConfirmed"
           value="false" />

    <div class="mb-3">
        <label asp-for="FirstName" class="form-label">
            First name *
        </label>

        <input asp-for="FirstName"
               minlength="@StudentConstants.MinFirstNameLength"
               maxlength="@StudentConstants.MaxFirstNameLength"
               class="form-control" />

        <span asp-validation-for="FirstName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="LastName" class="form-label">
            Last name *
        </label>

        <input asp-for="LastName"
               minlength="@StudentConstants.MinLastNameLength"
               maxlength="@StudentConstants.MaxLastNameLength"
               class="form-control" />

        <span asp-validation-for="LastName" class="text-danger"></span>
    </div>


    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Course" class="form-label"></label>
        <input asp-for="Course" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="DateOfBirth" class="form-label">
            Date of birth *
        </label>

        <input asp-for="DateOfBirth"
               type="date"
               class="form-control"
               id="dateOfBirthInput"
               readonly="@Model.IsDateOfBirthEstimated" />

        @if (Model.IsDateOfBirthEstimated)
        {
            <div class="alert alert-warning mt-2">
                <strong>Notice:</strong>
                This date of birth was automatically generated from the
                previous age information.
                Please enter the actual date of birth.
            </div>

            <button type="button"
                    id="updateDateOfBirthButton"
                    class="btn btn-outline-primary">
                Update date of birth
            </button>
        }
    </div>



    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
   <script>
               document.getElementById("updateDateOfBirthButton")?.addEventListener("click", function () {
            const input = document.getElementById("dateOfBirthInput");
            const confirmed = document.getElementById("dateOfBirthConfirmed");

            input.removeAttribute("readonly");
            confirmed.value = "true";

            input.focus();

            this.style.display = "none";
        });

    </script>

</form>
